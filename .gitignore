# ───────────────────────────────────────────────────────────────
# Baseball Analytics — Python / R / Streamlit .gitignore
# ───────────────────────────────────────────────────────────────

# ── Data files (keep repo lightweight; host large data elsewhere) ──
*.csv
*.parquet
*.feather
*.pkl
*.pickle
*.h5
*.hdf5
*.db
*.sqlite
*.sqlite3
data/
datasets/
raw/
processed/
exports/

# Exception: allow small sample/schema files explicitly
!sample_*.csv
!schema.sql
!**/sample/*.csv

# ── pybaseball cache ──
pybaseball_cache/
.pybaseball/
*_cache/

# ── Python ──
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# ── Virtual environments ──
.venv/
venv/
env/
ENV/
.env
.env.local
.env.*.local

# ── Jupyter ──
.ipynb_checkpoints/
*/.ipynb_checkpoints/*
*.nbconvert.ipynb
profile_default/
ipython_config.py

# ── Streamlit ──
.streamlit/secrets.toml

# ── R ──
.Rhistory
.Rapp.history
.RData
.Ruserdata
*.Rproj.user/
*.Rproj
.Rcheck/

# ── Models & artifacts ──
*.joblib
*.model
*.bin
models/
checkpoints/

# ── Logs ──
*.log
logs/

# ── OS / editor ──
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*.swo
*~

# ── Secrets / credentials ──
*.pem
*.key
credentials.json
secrets.yaml
